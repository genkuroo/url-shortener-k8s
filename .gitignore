# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local Kubernetes / tooling
kubeconfig
*.kubeconfig
.env

# Terraform (EKS stretch phase)
# State files record real infrastructure and can contain sensitive values; tfvars
# may hold account-specific settings. Only terraform.tfvars.example is committed.
terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
# The provider lock file IS committed (same as url-shortener-aws/infra) — it pins
# provider versions so a later `terraform init` resolves exactly what was validated.
!terraform/.terraform.lock.hcl

# OS
.DS_Store

# Sealed Secrets — the controller's PRIVATE key.
# `make seal-key-backup` writes it OUTSIDE the repo (~/.config/sealed-secrets/),
# so this pattern is a second line of defence, not the primary one: it catches a
# key accidentally dumped here by hand. That one file decrypts every SealedSecret
# in this repo and belongs in a password manager.
sealed-secrets-key*.yaml
